__pycache__/
.pytest_cache/
.venv/
*.py[cod]

# Daily data is reproducible and is intentionally not versioned.
data/daily/*.parquet

# Temporary parquet writes must never be committed.
data/**/*.tmp

# Kripto saatlik veri arsivlenmez: Binance tum gecmisi her zaman verir (lider karari).
# Arsiv yalniz kayan pencereli yfinance verisi (BIST, ABD, emtia) icindir.
data/hourly/*USDT*.parquet

# Dakikalik arsivler (kripto, buyuk) versiyonlanmaz.
data/1m/
data/5m/
data/15m/
data/30m/

# Islem dokumleri buyuk ve yeniden uretilebilir (huni/CI her kosuda yazar); repoya girmez (lider, 2026-10-24).
results/tarama_islemler/
results/trades/
results/u1/**/islemler_*.csv
results/u1/islemler_*.csv
results/u4/**/islemler_*.csv
results/u4/islemler_*.csv
